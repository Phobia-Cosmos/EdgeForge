[Unit]
Description=EdgeForge control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgeforge
Group=edgeforge
EnvironmentFile=/etc/edgeforge/edgeforge.env
WorkingDirectory=/var/lib/edgeforge
ExecStart=/usr/bin/python3 -m edgeforge control --bind 0.0.0.0 --database /var/lib/edgeforge/edgeforge.db
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edgeforge
LogsDirectory=edgeforge

[Install]
WantedBy=multi-user.target
